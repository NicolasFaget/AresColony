; Engine configuration file.

config_version=5

[application]

config/name="Ares Colony"
config/version="0.1"
config/icon="res://art/app_icon/icon.png"
run/main_scene="res://ui/menu.tscn"
config/features=PackedStringArray("4.5", "Mobile")
boot_splash/bg_color=Color(0.043, 0.035, 0.024, 1)
boot_splash/show_image=false

[autoload]

GameManager="*res://game/game_manager.gd"
AudioManager="*res://game/audio_manager.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=450
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
scaling_3d/scale.mobile=0.62
anti_aliasing/quality/msaa_3d.mobile=0
anti_aliasing/quality/screen_space_aa.mobile=1
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
environment/defaults/default_clear_color=Color(0.1, 0.15, 0.19, 1)
